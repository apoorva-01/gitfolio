# =============================================================================
# GitFolio Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control!

# -----------------------------------------------------------------------------
# DATABASE (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# Get your connection string from neon.tech → Dashboard → Connection Details
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-xxx-123456.us-east-2.aws.neon.tech/gitfolio?sslmode=require

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# NextAuth secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# App URL (change port if not using 5162)
NEXTAUTH_URL=http://localhost:5162

# -----------------------------------------------------------------------------
# GITHUB OAUTH
# -----------------------------------------------------------------------------
# 1. Go to: https://github.com/settings/developers → New OAuth App
# 2. Fill in:
#    - Application name: GitFolio
#    - Homepage URL: http://localhost:5162
#    - Authorization callback URL: http://localhost:5162/api/auth/callback/github
# 3. Copy Client ID and generate Client Secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# -----------------------------------------------------------------------------
# AI / ANALYTICS (Anthropic Claude)
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/
# Used for repository and profile AI analysis
ANTHROPIC_API_KEY=your_anthropic_api_key

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Encryption key for GitHub tokens - generate with: openssl rand -hex 32
# 32 bytes = 256 bits for AES-256 encryption
ENCRYPTION_KEY=your_32_byte_hex_encryption_key

# -----------------------------------------------------------------------------
# PORTS (optional - defaults shown)
# -----------------------------------------------------------------------------
PORT=5162